# ═══════════════════════════════════════════════════════════════
# Kyra Estoque — variáveis de ambiente obrigatórias
# Copie para .env.local e preencha os valores reais.
# NUNCA commite .env.local ou qualquer arquivo com segredos reais.
# ═══════════════════════════════════════════════════════════════

# ── Supabase ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...     # chave pública (anon)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...               # chave secreta (NUNCA expor ao cliente)

# ── IA Providers ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
GROQ_API_KEY=                                          # opcional
OPENAI_API_KEY=                                        # opcional

# ── Email (Resend) ────────────────────────────────────────────
RESEND_API_KEY=re_...                                  # necessário para automações de e-mail

# ── Billing (Asaas) ───────────────────────────────────────────
ASAAS_WEBHOOK_TOKEN=                                   # token de validação de webhooks do Asaas
ASAAS_API_KEY=                                         # chave da API Asaas (se houver integração direta)

# ── Webhooks de canais de venda ───────────────────────────────
# Gerados automaticamente por empresa — não é necessário configurar manualmente

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Monitoramento ─────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=                                # opcional
